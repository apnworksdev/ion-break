---
import AppImage from '../components/AppImage.astro';
import { ViewTransitions } from 'astro:transitions';
import logo from '../assets/images/logo-metallic.png';
import '../styles/variables.css';
import '../styles/global.css';
import '../styles/main.css';

interface Props {
  title: string;
  hideHeader?: boolean;
}

const { title, hideHeader = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />

    <title>{title}</title>
    <slot name="head" />
    <ViewTransitions />
  </head>
  <body>
    <header class="header" data-hide={hideHeader || undefined}>
      <nav class="header-nav">
        <a
          href="/"
          id="logo-link"
          transition:persist="logo"
        >
          <AppImage
            src={logo}
            alt="ION Break"
            id="logo"
            width={700}
            height={200}
            fetchpriority="high"
          />
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>