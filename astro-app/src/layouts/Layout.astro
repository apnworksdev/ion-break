---
import AppImage from '../components/AppImage.astro';
import { ViewTransitions } from 'astro:transitions';
import logo from '../assets/images/logo-metallic.png';
import '../styles/variables.css';
import '../styles/global.css';
import '../styles/main.css';

interface Props {
  title: string;
  hideHeader?: boolean;
}

const { title, hideHeader = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />

    <title>{title}</title>
    <slot name="head" />
    <ViewTransitions />
  </head>
  <body>
    <header class="header" data-hide={hideHeader || undefined}>
      <nav class="header-nav">
        <a
          href="/"
          id="logo-link"
          transition:persist="logo"
        >
          <AppImage
            src={logo}
            alt="ION Break"
            id="logo"
            width={700}
            height={200}
            fetchpriority="high"
          />
        </a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script>
      document.addEventListener('fullscreenchange', () => {
        if (!document.fullscreenElement) {
          screen.orientation?.unlock?.();
        }
      });

      document.addEventListener('click', async (e) => {
        const target = e.target instanceof Element ? e.target : null;
        const link = target?.closest('a[href="/game"]');
        if (!link) return;
        if (e.ctrlKey || e.metaKey || e.button !== 0) return;
        const el = document.documentElement as HTMLElement & Record<string, unknown>;
        const req = el.requestFullscreen ?? el.webkitRequestFullscreen ?? el.mozRequestFullScreen ?? el.msRequestFullscreen;
        try {
          if (typeof req === 'function') await req.call(el);
        } catch (error) {
          console.error("Failed to request fullscreen:", error);
        }
        // 2️⃣ LOCK TO LANDSCAPE
        try {
          const lock = (screen.orientation as { lock?: (mode: string) => Promise<void> })?.lock;
          if (lock) await lock.call(screen.orientation, 'landscape');
        } catch (err) {
          console.warn('Orientation lock failed:', err);
        }
      }, true);
    </script>
  </body>
</html>