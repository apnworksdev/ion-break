---
/**
 * Wrapper around Astro's Picture (and getImage when mobile). Use everywhere for a single API.
 *
 * - Always uses one <picture>: avif + webp for desktop (and optional mobile source first).
 * - With mobileSrc/mobileSrcSet: adds <source media="(max-width: 820px)"> so mobile gets its own image.
 * - Wrapper has data-app-image for fade-in and reveal-when-ready.
 */
import { getImage, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  /** Encoding quality: number 0-100 or "low"|"mid"|"high"|"max". */
  quality?: number | "low" | "mid" | "high" | "max";
  /** Optional mobile image (used in <picture> below 820px). */
  mobileSrc?: ImageMetadata | string;
  /** Optional mobile srcset when using <picture>. */
  mobileSrcSet?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  width,
  height,
  class: className,
  loading,
  fetchpriority,
  decoding = "async",
  quality,
  mobileSrc,
  mobileSrcSet,
  ...rest
} = Astro.props;

const hasMobile = mobileSrc ?? mobileSrcSet;
const breakpoint = "(aspect-ratio <= 1/1)";
const castSrc = src as ImageMetadata & string;

// srcset must be a URL string; resolve ImageMetadata to .src
const mobileSrcUrl =
  mobileSrcSet ??
  (typeof mobileSrc === "string" ? mobileSrc : (mobileSrc as ImageMetadata)?.src ?? "");

// When we have a mobile image, build one <picture> with: mobile source + (avif + webp for desktop) + img
let desktopAvif: string | undefined;
let desktopWebp: string | undefined;
const initialFallback =
  typeof castSrc === "string" ? castSrc : (castSrc as ImageMetadata).src;
let desktopFallback: string = initialFallback;

if (hasMobile) {
  try {
    const baseOpts = { src: castSrc, width, height, ...(quality != null && { quality }) };
    const [avif, webp, fallback] = await Promise.all([
      getImage({ ...baseOpts, format: "avif" }),
      getImage({ ...baseOpts, format: "webp" }),
      getImage({ src: castSrc, width, height, ...(quality != null && { quality }) }),
    ]);
    desktopAvif = avif.src;
    desktopWebp = webp.src;
    desktopFallback = fallback.src;
  } catch {
    // getImage failed (e.g. remote without config); keep desktopFallback as original src
  }
}

const useCustomPicture = hasMobile;
---

<div class="app-image" data-app-image>
  {useCustomPicture ? (
    <picture>
      {mobileSrcUrl && (
        <source media={breakpoint} srcset={mobileSrcUrl} />
      )}
      {desktopAvif && <source type="image/avif" srcset={desktopAvif} />}
      {desktopWebp && <source type="image/webp" srcset={desktopWebp} />}
      <img
        src={desktopFallback}
        alt={alt}
        width={width}
        height={height}
        class={className}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={decoding}
        {...rest}
      />
    </picture>
  ) : (
    <Picture
      src={castSrc}
      formats={["avif", "webp"]}
      alt={alt}
      width={width}
      height={height}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      {...(quality != null && { quality })}
      {...rest}
    />
  )}
</div>
