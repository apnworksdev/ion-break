---
/**
 * Wrapper around Astro's Picture (and getImage when mobile). Use everywhere for a single API.
 *
 * - With mobileSrc/mobileSrcSet: uses one <picture> with mobile source at (max-width: 820px), then avif + webp for desktop, then img fallback.
 * - Mobile ImageMetadata is passed through getImage() so the built URL is correct (same as desktop).
 */
import { getImage, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata | string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  decoding?: "async" | "sync" | "auto";
  /** Encoding quality: number 0-100 or "low"|"mid"|"high"|"max". */
  quality?: number | "low" | "mid" | "high" | "max";
  /** Optional mobile image (used in <picture> below 820px). */
  mobileSrc?: ImageMetadata | string;
  /** Optional mobile srcset when using <picture>. */
  mobileSrcSet?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  width,
  height,
  class: className,
  loading,
  fetchpriority,
  decoding = "async",
  quality,
  mobileSrc,
  mobileSrcSet,
  ...rest
} = Astro.props;

const hasMobile = mobileSrc ?? mobileSrcSet;
const breakpoint = "(aspect-ratio <= 1/1)";
const castSrc = src as ImageMetadata & string;

// Resolve mobile URL: use getImage for ImageMetadata so we get the built URL; string stays as-is.
let mobileSrcUrl = mobileSrcSet ?? "";
if (!mobileSrcUrl && mobileSrc) {
  if (typeof mobileSrc === "string") {
    mobileSrcUrl = mobileSrc;
  } else {
    try {
      const mobileImg = await getImage({
        src: mobileSrc as ImageMetadata,
        width,
        height,
        ...(quality != null && { quality }),
      });
      mobileSrcUrl = mobileImg.src;
    } catch {
      mobileSrcUrl = (mobileSrc as ImageMetadata)?.src ?? "";
    }
  }
}

// When we have a mobile image, build one <picture>: mobile source + (avif + webp for desktop) + img fallback.
let desktopAvif: string | undefined;
let desktopWebp: string | undefined;
const initialFallback =
  typeof castSrc === "string" ? castSrc : (castSrc as ImageMetadata).src;
let desktopFallback: string = initialFallback;

if (hasMobile) {
  try {
    const baseOpts = { src: castSrc, width, height, ...(quality != null && { quality }) };
    const [avif, webp, fallback] = await Promise.all([
      getImage({ ...baseOpts, format: "avif" }),
      getImage({ ...baseOpts, format: "webp" }),
      getImage({ ...baseOpts, format: "png" }),
    ]);
    desktopAvif = avif.src;
    desktopWebp = webp.src;
    desktopFallback = fallback.src;
  } catch {
    // getImage failed (e.g. remote without config); keep desktopFallback as original src
  }
}

const useCustomPicture = hasMobile;
---

<div class="app-image">
  {useCustomPicture ? (
    <picture>
      {mobileSrcUrl && (
        <source media={breakpoint} srcset={mobileSrcUrl} />
      )}
      {desktopAvif && <source type="image/avif" srcset={desktopAvif} />}
      {desktopWebp && <source type="image/webp" srcset={desktopWebp} />}
      <img
        {...rest}
        src={desktopFallback}
        alt={alt}
        width={width}
        height={height}
        class={className}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={decoding}
      />
    </picture>
  ) : (
    <Picture
      src={castSrc}
      formats={["avif", "webp"]}
      alt={alt}
      width={width}
      height={height}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
      {...(quality != null && { quality })}
      {...rest}
    />
  )}
</div>
