---
import AppImage from "./AppImage.astro";
import { urlFor } from "../utils/image";
import type { Taste } from "../utils/sanity";
import "../styles/components.css";

interface Props {
  taste: Taste;
  currentIndex: number;
  totalCount: number;
  priority?: boolean;
}

const { taste, currentIndex, totalCount, priority = false } = Astro.props;

const imgSrc = taste.mainImage
  ? urlFor(taste.mainImage).width(2000).height(1600).url()
  : "";
---

  <div class="card" data-tilt>
    <h3 class="card-title">
      {taste.title}
    </h3>
    
    <hover-tilt tilt-factor="1.4" scale-factor="1">
      {
        taste.mainImage && imgSrc ? (
          <AppImage
            src={imgSrc}
            alt={taste.mainImage.alt || ""}
            width={2000}
            height={1600}
            class="card-cover"
            loading={priority ? undefined : "lazy"}
            fetchpriority={priority ? "high" : undefined}
          />
        ) : (
          <div class="card-cover--none" />
        )
      }
    </hover-tilt>

    <div class="card-description-container">
      <p>
        [<span class="card-current-index">{String(currentIndex).padStart(2, '0')}</span>/<span class="card-total-count">{String(totalCount).padStart(2, '0')}</span>]
      </p>

      <p class="card-description">
        {taste.description}
      </p>
    </div>
  </div>
