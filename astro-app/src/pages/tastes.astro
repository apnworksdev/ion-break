---
import AppImage from "../components/AppImage.astro";
import Card from "../components/Card.astro";
import Layout from "../layouts/Layout.astro";
import { getTastes } from "../utils/sanity";
import { Swiper, SwiperWrapper, SwiperSlide } from "astro-swiper";
import bg from "../assets/images/tastes-background-desktop.png";
import mobileBg from "../assets/images/tastes-background-mobile.png";
import "../styles/tastes.css";

const tastes = await getTastes();
---

<Layout title="Products - ION Break">
  <div class="tastes-page">
    <div class="tastes-page-background-container">
      <AppImage
        src={bg}
        mobileSrc={mobileBg}
        alt="ION Break"
        class="tastes-page-background-image"
        width={1920}
        height={1080}
        fetchpriority="high"
      />
    </div>
    <Swiper
      options={{
        loop: true,
        speed: 400,
        centeredSlides: true,
        grabCursor: true,
        navigation: {
          nextEl: '.swiper-button-next',
          prevEl: '.swiper-button-prev',
        },
        mousewheel: {
          forceToAxis: false,
        },
        keyboard: {
          enabled: true,
          onlyInViewport: false,
        },
        slidesPerView: 2.5,
        breakpoints: {
          820: {
            slidesPerView: 2,
          },
        }
      }}>
      <SwiperWrapper>
        {tastes.length ? tastes.map((taste, index) => <SwiperSlide><Card taste={taste} currentIndex={index + 1} totalCount={tastes.length} priority={index === 0} eager /></SwiperSlide>) : ''}
        {tastes.length ? tastes.map((taste, index) => <SwiperSlide><Card taste={taste} currentIndex={index + 1} totalCount={tastes.length} eager /></SwiperSlide>) : ''}
      </SwiperWrapper>

      <div class="swiper-button-prev">
      </div>
      <div class="swiper-button-next">
      </div>

    </Swiper>
    <a href="/" class="back-button">
      <span class="back-button-text">Close</span>
    </a>
  </div>
</Layout>

<script>
  import 'hover-tilt/web-component';
</script>