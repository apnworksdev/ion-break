---
import AppImage from "../components/AppImage.astro";
import Layout from "../layouts/Layout.astro";
import hero from "../assets/images/landing-face-desktop.png";
import mobileHero from "../assets/images/landing-face-mobile.png";
import gameIcon from "../assets/images/landing-game-icon.png";
import tastesIcon from "../assets/images/landing-tastes-icon.png";
import phoneIcon from "../assets/images/landing-phone-desktop.png";
import mobilePhoneIcon from "../assets/images/landing-phone-mobile.png";
import hands from "../assets/images/landing-hands-desktop.png";
import mobileHands from "../assets/images/landing-hands-mobile.png";
import "../styles/home.css";
export const prerender = true;
---

<Layout title="ION Break">
  <div class="landing-container">
    <div class="landing-face-container">
      <AppImage
        src={hero}
        mobileSrc={mobileHero}
        alt="ION Break"
        class="landing-face-image"
        width={1920}
        height={1080}
        quality="high"
        fetchpriority="high"
      />
    </div>
    <div class="landing-links-container">
      <div class="landing-links-item game">
        <a href="/game" class="landing-link-link landing-link-hit">
        </a>
        <div class="landing-link-image-container">
          <p class="landing-link-text">Play the game</p>
          <AppImage
            src={gameIcon}
            alt="Play game"
            class="landing-link-image"
            width={800}
            height={800}
            quality="high"
            fetchpriority="high"
          />
        </div>
      </div>
      <div class="landing-links-item tastes">
        <a href="/tastes" class="landing-link-link landing-link-hit">
        </a>
        <div class="landing-link-image-container">
          <p class="landing-link-text">Tastes/Fillings</p>
          <AppImage
            src={tastesIcon}
            alt="Tastes"
            class="landing-link-image"
            width={800}
            height={800}
            quality="high"
            fetchpriority="high"
          />
        </div>
      </div>
      <div class="landing-links-item video">
        <a href="/video" class="landing-link-link landing-link-hit">
        </a>
        <div class="landing-link-image-container">
          <p class="landing-link-text">Watch the clip</p>
          <AppImage
            src={phoneIcon}
            mobileSrc={mobilePhoneIcon}
            alt="Watch the clip"
            class="landing-link-image"
            width={800}
            height={800}
            quality="high"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
    <div class="landing-hands-container">
      <AppImage
        src={hands}
        mobileSrc={mobileHands}
        alt="ION Break"
        class="landing-hands-image"
        width={1920}
        height={1080}
        quality="high"
        fetchpriority="high"
      />
    </div>
  </div>
</Layout>