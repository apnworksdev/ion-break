---
import Layout from "../layouts/Layout.astro";
import { getFullVideo } from '../utils/sanity';
import "../styles/video.css";

const fullVideo = await getFullVideo();
---

<Layout title="Video - ION Break">
  <div class="video-page">
    <div class="video-container">
      {fullVideo && (fullVideo.videoFile || fullVideo.videoUrl) && (
        <div class="video-wrapper">
          <video
            id="full-video"
            class="full-video"
            autoplay
            muted
            loop
            playsinline
            poster={fullVideo.posterImage}
          >
            <source src={fullVideo.videoUrl || fullVideo.videoFile} type="video/mp4" />
          </video>
        </div>
      )}
      <div class="video-hands-container">
        <img src="/img/video-hands-desktop.png" alt="ION Break" class="video-hands-image" />
      </div>
    </div>
    <div class="controls-container">
      <a href="/" class="back-button"><span class="back-button-text">Close</span></a>
      <div class="video-buttons-container">
        <button id="video-play-button" class="video-button" aria-label="Play/Pause Video">Play / Pause</button>
        <button id="video-mute-button" class="video-button" aria-label="Mute/Unmute Video">Unmute</button>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const video = document.getElementById('full-video');
    if (video) {

      video.onclick = () => {
        if (video.paused) {
          video.play();
        } else {
          video.pause();
        }
      };

      const playButton = document.getElementById('video-play-button');
      if (playButton) {
        playButton.onclick = () => {
          if (video.paused) {
            video.play();
          } else {
            video.pause();
          }
        };
      }

      const muteButton = document.getElementById('video-mute-button');
      if (muteButton) {
        const setMuteButtonLabel = () => {
          muteButton.textContent = video.muted ? 'Unmute' : 'Mute';
        };
        setMuteButtonLabel();
        muteButton.onclick = () => {
          if (video.muted) {
            const tempVolume = video.volume || 1;
            video.volume = 0;
            video.muted = false;
            setMuteButtonLabel();
            let vol = 0;
            const fadeIn = setInterval(() => {
              if (vol < tempVolume) {
                vol += 0.1;
                video.volume = Math.min(vol, tempVolume);
              } else {
                clearInterval(fadeIn);
              }
            }, 10);
          } else {
            video.muted = true;
            setMuteButtonLabel();
          }
        };
      }
    }
  });
</script>