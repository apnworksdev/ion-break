---
import AppImage from "../components/AppImage.astro";
import Layout from "../layouts/Layout.astro";
import { getFullVideo } from '../utils/sanity';
import hands from "../assets/images/video-hands-desktop.png";
import mobileHands from "../assets/images/video-hands-mobile.png";
import "../styles/video.css";

const fullVideo = await getFullVideo();
---

<Layout title="Video - ION Break">
  <div id="video-page" class="video-page age-overlay-visible">
    <div class="video-container">
      {fullVideo && (fullVideo.videoFile || fullVideo.videoUrl) && (
        <div class="video-wrapper">
          <video
            id="full-video"
            class="full-video"
            loop
            playsinline
            poster={fullVideo.posterImage}
          >
            <source src={fullVideo.videoUrl || fullVideo.videoFile} type="video/mp4" />
          </video>
          <div id="age-overlay" class="video-overlay age-overlay">
            <div class="age-overlay-content">
              <p class="age-overlay-text">Are you 18+ years old?</p>
              <div class="age-overlay-buttons">
                <a href="/" class="age-overlay-button age-overlay-button-exit">Exit</a>
                <button id="age-confirm-button" class="age-overlay-button age-overlay-button-proceed">Proceed</button>
              </div>
            </div>
          </div>
        </div>
      )}
      <div class="video-hands-container">
        <AppImage
          src={hands}
          mobileSrc={mobileHands}
          alt="ION Break"
          class="video-hands-image"
          width={1920}
          height={1080}
        />
      </div>
    </div>
    <div class="controls-container">
      <a href="/" class="back-button"><span class="back-button-text">Close</span></a>
      <div class="video-buttons-container">
        <button id="video-play-button" class="video-button" aria-label="Play/Pause Video">Play / Pause</button>
        <button id="video-mute-button" class="video-button" aria-label="Mute/Unmute Video">Mute</button>
      </div>
    </div>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    const video = document.getElementById('full-video');
    const ageOverlay = document.getElementById('age-overlay');
    const ageConfirmButton = document.getElementById('age-confirm-button');
    const videoPage = document.getElementById('video-page');

    if (ageOverlay && ageConfirmButton && videoPage) {
      ageConfirmButton.onclick = () => {
        ageOverlay.classList.add('age-overlay-hidden');
        videoPage.classList.remove('age-overlay-visible');
        if (video) {
          video.play();
        }
      };
    }

    if (video) {

      video.onclick = () => {
        if (video.paused) {
          video.play();
        } else {
          video.pause();
        }
      };

      const playButton = document.getElementById('video-play-button');
      if (playButton) {
        playButton.onclick = () => {
          if (video.paused) {
            video.play();
          } else {
            video.pause();
          }
        };
      }

      const muteButton = document.getElementById('video-mute-button');
      if (muteButton) {
        const setMuteButtonLabel = () => {
          muteButton.textContent = video.muted ? 'Unmute' : 'Mute';
        };
        setMuteButtonLabel();
        muteButton.onclick = () => {
          if (video.muted) {
            const tempVolume = video.volume || 1;
            video.volume = 0;
            video.muted = false;
            setMuteButtonLabel();
            let vol = 0;
            const fadeIn = setInterval(() => {
              if (vol < tempVolume) {
                vol += 0.1;
                video.volume = Math.min(vol, tempVolume);
              } else {
                clearInterval(fadeIn);
              }
            }, 10);
          } else {
            video.muted = true;
            setMuteButtonLabel();
          }
        };
      }
    }
  });
</script>